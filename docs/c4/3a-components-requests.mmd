---
config:
  layout: elk
  flowchart:
    wrappingWidth: 400
---
%% C4 Level 3a - Components of the Flight Operations API: the path of a client request, commands and queries apart (CQRS)
flowchart TB
    lb["<b>Load balancer</b><br/>[Container]"]

    subgraph API["Flight Operations API [Container: Java 21, Spring Boot] - one instance"]
        direction TB
        filters["<b>Request filters</b><br/>[Component: common.tracing, common.security, api]<br/><br/>Request id + X-Instance header, JWT to roles,<br/>audit log; on a query instance commands get 405"]
        auth["<b>AuthController</b><br/>[Component: security]<br/><br/>Sign-in; issues the user JWT<br/>accepted by all AISafe services"]
        flightApi["<b>Flight API</b><br/>[Component: api]<br/><br/>ScheduledFlight, AircraftUtilization,<br/>FuelEfficiency and Unicorns controllers"]

        subgraph CMD["Write side (commands)"]
            direction TB
            commands["<b>FlightCommandService</b><br/>[Component: services]<br/><br/>Schedule: on the aircraft's owner (its backup<br/>if the owner can't be reached).<br/>Cancel, Complete: on the first copy<br/>of the flight that is reached"]
            lbs["<b>LocalBookingService</b><br/>[Component: services]<br/><br/>Business rules, per-aircraft lock;<br/>saves the flight, its replication task and<br/>its event in one transaction"]
        end

        subgraph QRY["Read side (queries)"]
            direction TB
            queries["<b>FlightQueries + report services</b><br/>[Component: services]<br/><br/>Flights, departures, utilization (US223),<br/>fuel efficiency (US227), unicorns"]
            readModel["<b>Read model</b><br/>[Component: readmodel]<br/><br/>MongoReadModel: flights and reports<br/>already computed for the whole cluster"]
            fallback["<b>FlightQueryService</b><br/>[Component: services]<br/><br/>Fallback path (as in Assignment 1):<br/>local write database, then the peers"]
        end

        clients["<b>Aircraft and route directories</b><br/>[Component: clients]<br/><br/>Local copies fed by events; REST to the<br/>other services only for data not copied yet"]
        repos["<b>Repositories + field encryption</b><br/>[Component: repositories, common.crypto]<br/><br/>Spring Data JPA; route, aircraft and<br/>airports of each flight AES-256 encrypted"]
        dist["<b>Distribution components</b><br/>[see diagram 3b]<br/><br/>Cluster, PeerClient, replication"]
        events["<b>Events and read model upkeep</b><br/>[see diagram 3c]<br/><br/>Projection, outbox, relay, listener, sync"]
    end

    db[("<b>Write database</b><br/>[Container: PostgreSQL 16]")]
    rdb[("<b>Read database</b><br/>[Container: MongoDB 7]")]
    am["<b>Aircraft & Maintenance</b><br/>[Software System]"]
    ar["<b>Airports & Routes</b><br/>[Software System]"]

    lb -->|"HTTPS"| filters
    filters -->|"POST /api/auth/login"| auth
    filters -->|"/api/** (role checked)"| flightApi
    flightApi -->|"POST, PATCH"| commands
    flightApi -->|"GET"| queries
    commands -->|"not here: forward to the owner<br/>(booking) or a holder (cancel, complete)"| dist
    commands -->|"owner here, or a copy here"| lbs
    lbs -->|"aircraft available? route active?<br/>airports certified?"| clients
    lbs -->|"flight + tasks + event"| repos
    lbs -.->|"FlightChanged"| events
    queries -->|"read model READY"| readModel
    queries -.->|"not READY, or<br/>X-Read-Side: write-side"| fallback
    fallback -->|"local data"| repos
    fallback -->|"not here / lists:<br/>ask the peers"| dist
    events -->|"keeps up to date"| readModel
    readModel -->|"MongoDB driver"| rdb
    repos -->|"JDBC"| db
    clients -->|"REST, service JWT"| am
    clients -->|"REST, service JWT"| ar

    classDef component fill:#85bbf0,stroke:#5d82a8,color:#000000
    classDef container fill:#438dd5,stroke:#2e6295,color:#ffffff
    classDef external fill:#999999,stroke:#6b6b6b,color:#ffffff
    classDef elsewhere fill:#ffffff,stroke:#5d82a8,color:#000000,stroke-dasharray:4 3
    class filters,auth,flightApi,commands,lbs,queries,readModel,fallback,clients,repos component
    class dist,events elsewhere
    class lb,db,rdb container
    class am,ar external
    style API fill:none,stroke:#444444,stroke-dasharray:6 4
    style CMD fill:none,stroke:#5d82a8
    style QRY fill:none,stroke:#5d82a8
