---
config:
  layout: elk
  flowchart:
    wrappingWidth: 400
---
%% C4 Deployment diagram - Flight Operations on Kubernetes (Docker Desktop, k8s/). Values from k8s/*.yaml.
flowchart TB
    browser["<b>Client machine</b><br/>[Deployment node: browser, Postman, k6]"]

    subgraph NODE["Docker Desktop [Deployment node: Kubernetes v1.36, kubeadm, 1 node]"]
        direction TB
        subgraph NS["Namespace aisafe"]
            direction TB
            lbsvc["<b>Service flightops</b><br/>[type LoadBalancer, https://localhost:9443]<br/><br/>Sends requests only to ready pods"]
            headless["<b>Service flightops-peers</b><br/>[headless, publishNotReadyAddresses]<br/><br/>DNS name per pod:<br/>flightops-N.flightops-peers"]
            hpa["<b>HorizontalPodAutoscaler</b><br/>[3 to 5 pods]<br/><br/>Adds a pod above 70 % CPU,<br/>removes one after 2 min of low load"]
            secrets["<b>Secrets + ConfigMap</b><br/><br/>JWT key, DB password, encryption key,<br/>certificates; profiles, service URLs"]

            subgraph STS["StatefulSet flightops [pods flightops-0 .. flightops-4]"]
                direction LR
                subgraph POD0["Pod flightops-0"]
                    direction TB
                    app0["<b>Flight Operations API</b><br/>[Container: Java 21, Spring Boot]<br/>CPU 0.25-1, memory 512-768 MiB<br/>probes: startup, readiness, liveness"]
                    pg0[("<b>Flight database</b><br/>[Container: PostgreSQL 16, sidecar]")]
                    pvc0[("<b>Disk</b><br/>[PersistentVolumeClaim 1 GiB]")]
                end
                subgraph POD1["Pod flightops-1"]
                    direction TB
                    app1["<b>Flight Operations API</b>"]
                    pg1[("<b>Flight database</b>")]
                    pvc1[("<b>Disk</b>")]
                end
                subgraph POD2["Pod flightops-2"]
                    direction TB
                    app2["<b>Flight Operations API</b>"]
                    pg2[("<b>Flight database</b>")]
                    pvc2[("<b>Disk</b>")]
                end
            end

            others["<b>StatefulSets aircraft, airports</b><br/>[other teams' services, 1 or 3 pods each]"]
        end
        ms["<b>metrics-server</b><br/>[kube-system]<br/><br/>CPU of every container"]
    end

    browser -->|"HTTPS (TLS 1.3)"| lbsvc
    lbsvc --> app0
    lbsvc --> app1
    lbsvc --> app2
    app0 -->|"localhost:5432"| pg0
    pg0 --- pvc0
    app1 --> pg1
    pg1 --- pvc1
    app2 --> pg2
    pg2 --- pvc2
    app0 <-->|"HTTPS /internal/**"| app1
    app1 <-->|"HTTPS /internal/**"| app2
    app0 -.->|"who exists? every 5 s"| headless
    hpa -->|"scales"| STS
    hpa -->|"reads CPU"| ms
    secrets -.-> STS
    app2 -->|"REST, service JWT"| others

    classDef container fill:#438dd5,stroke:#2e6295,color:#ffffff
    classDef infra fill:#ffffff,stroke:#666666,color:#000000
    classDef external fill:#999999,stroke:#6b6b6b,color:#ffffff
    class app0,app1,app2,pg0,pg1,pg2 container
    class lbsvc,headless,hpa,secrets,ms,pvc0,pvc1,pvc2,browser infra
    class others external
    style NODE fill:#f4f4f4,stroke:#444444
    style NS fill:#fbfbfb,stroke:#888888,stroke-dasharray:6 4
    style STS fill:#eef4fb,stroke:#5d82a8
    style POD0 fill:#ffffff,stroke:#5d82a8
    style POD1 fill:#ffffff,stroke:#5d82a8
    style POD2 fill:#ffffff,stroke:#5d82a8
