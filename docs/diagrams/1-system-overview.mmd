%% PL3 p.20 - the distributed system: 3 components x 2 instances, each instance with its own database
flowchart LR
    client["Clients<br/>(Postman, k6, a frontend)"]

    subgraph FO["flight-operations-service (this repo)"]
        direction TB
        fo1["instance1<br/>:8083"]
        fo2["instance2<br/>:8093"]
        db1[("PostgreSQL<br/>flightops-db-1<br/>:5433")]
        db2[("PostgreSQL<br/>flightops-db-2<br/>:5434")]
        fo1 --- db1
        fo2 --- db2
        fo1 <-->|"peer forwarding<br/>/internal/flights/**"| fo2
    end

    subgraph AM["aircraft-maintenance-service"]
        direction TB
        am1["instance1<br/>:8081"]
        am2["instance2<br/>:8091"]
        am1 <-->|peers| am2
    end

    subgraph AR["airports-routes-service"]
        direction TB
        ar1["instance1<br/>:8082"]
        ar2["instance2<br/>:8092"]
        ar1 <-->|peers| ar2
    end

    client -->|"HTTPS + user JWT<br/>(any instance)"| fo1
    client --> fo2
    FO -->|"GET /internal/aircraft/{reg}<br/>round-robin + failover"| AM
    FO -->|"GET /internal/routes/{id}<br/>GET /internal/airports/{iata}"| AR

    classDef db fill:#eef6ff,stroke:#5b8def
    class db1,db2 db
