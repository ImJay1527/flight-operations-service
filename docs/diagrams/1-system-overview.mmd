%% PL3 p.20 - the distributed system: 3 components x 2 instances, each flight-ops instance with its own database
flowchart LR
    client["Clients<br/>(Postman, k6, a frontend)"]
    lb["Load balancer (nginx)<br/>https://localhost:8443<br/>least connections + failover"]

    subgraph FO["flight-operations-service (this repo)"]
        direction TB
        fo1["instance1<br/>:8083"]
        fo2["instance2<br/>:8093"]
        db1[("PostgreSQL<br/>flightops-db-1<br/>:5433<br/>encrypted columns")]
        db2[("PostgreSQL<br/>flightops-db-2<br/>:5434<br/>encrypted columns")]
        fo1 --- db1
        fo2 --- db2
        fo1 <-->|"peer forwarding /internal/flights/**<br/>bookings go to the aircraft's owner"| fo2
    end

    subgraph AM["aircraft-maintenance-service"]
        direction TB
        am1["instance1<br/>:8081"]
        am2["instance2<br/>:8091"]
        am1 <-->|peers| am2
    end

    subgraph AR["airports-routes-service"]
        direction TB
        ar1["instance1<br/>:8082"]
        ar2["instance2<br/>:8092"]
        ar1 <-->|peers| ar2
    end

    client -->|"HTTPS (TLS 1.3) + user JWT"| lb
    lb --> fo1
    lb --> fo2
    FO -->|"GET /internal/aircraft/{reg}<br/>round-robin + failover"| AM
    FO -->|"GET /internal/routes/{id}<br/>GET /internal/airports/{iata}"| AR

    classDef db fill:#eef6ff,stroke:#5b8def
    class db1,db2 db
