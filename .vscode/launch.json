{
    // Run and Debug panel -> pick a compound to start both instances at once.
    // Each instance is a Spring profile: src/main/resources/application-instance<N>.properties
    // HTTPS variants need the certificates first: ./scripts/generate-dev-certs.sh
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "flightops-1 (HTTP :8083)",
            "request": "launch",
            "mainClass": "pt.isep.sidis.flightops.FlightOperationsApplication",
            "projectName": "flight-operations-service",
            "cwd": "${workspaceFolder}",
            "args": "--spring.profiles.active=instance1"
        },
        {
            "type": "java",
            "name": "flightops-2 (HTTP :8093)",
            "request": "launch",
            "mainClass": "pt.isep.sidis.flightops.FlightOperationsApplication",
            "projectName": "flight-operations-service",
            "cwd": "${workspaceFolder}",
            "args": "--spring.profiles.active=instance2"
        },
        {
            "type": "java",
            "name": "flightops-1 (HTTPS :8083)",
            "request": "launch",
            "mainClass": "pt.isep.sidis.flightops.FlightOperationsApplication",
            "projectName": "flight-operations-service",
            "cwd": "${workspaceFolder}",
            "args": "--spring.profiles.active=instance1,tls"
        },
        {
            "type": "java",
            "name": "flightops-2 (HTTPS :8093)",
            "request": "launch",
            "mainClass": "pt.isep.sidis.flightops.FlightOperationsApplication",
            "projectName": "flight-operations-service",
            "cwd": "${workspaceFolder}",
            "args": "--spring.profiles.active=instance2,tls"
        }
    ],
    "compounds": [
        {
            "name": "Flight Ops: 2 instances (HTTP)",
            "configurations": ["flightops-1 (HTTP :8083)", "flightops-2 (HTTP :8093)"],
            "stopAll": true
        },
        {
            "name": "Flight Ops: 2 instances (HTTPS)",
            "configurations": ["flightops-1 (HTTPS :8083)", "flightops-2 (HTTPS :8093)"],
            "stopAll": true
        }
    ]
}
